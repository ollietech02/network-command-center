# Network Command Center settings (no passwords here). The installer fills this in as config/ncc.env.
# Passwords and keys go in ~/.config/ncc/secrets.env (readable only by you), never in this folder.
BIND=127.0.0.1
PORT=8088
# Seconds between internet/system checks, and between device scans
INTERVAL=60
DEVICE_INTERVAL=300
# Leave GATEWAY empty to find your router automatically
GATEWAY=
WAN_TARGET=1.1.1.1
HTTPS_URL=https://www.google.com/generate_204
DNS_TEST_NAME=example.com
RETENTION_DAYS=30
# Look: scifi | hacker | clean (each person can also pick their own in Tools & settings)
STYLE=scifi
# generic, or att for AT&T gateways (BGW210/BGW320): adds router stats read from its status pages
ROUTER=generic
# Ad blocker: set ONE of these. Pi-hole password = PIHOLE_PASSWORD in secrets.env;
# AdGuard Home = ADGUARD_USER and ADGUARD_PASSWORD in secrets.env.
PIHOLE_URL=
ADGUARD_URL=
PIHOLE_INSECURE_TLS=1
# 1 = pause/resume blocking buttons
PIHOLE_CONTROLS=0
# 1 = edit your allow/block lists from the dashboard
PIHOLE_LISTS=0
# 1 = "block this device" (Pi-hole only)
PIHOLE_BLOCK=0
# 1 = restart buttons (dashboard / ad blocker / this computer)
SYSTEM_CONTROLS=0
# 1 = "Update now" button for new versions (backs up first; keeps data/ and this file). 0 if you changed the code yourself
UPDATE_BUTTON=1
# Troubleshooting answers from YOUR OWN AI assistant: claude (Claude Code), codex (Codex CLI), gemini (Gemini CLI) or off.
# It runs that program on this computer with your own sign-in; it can also be picked in Tools & settings → AI assistant.
AI_ASSISTANT=off
# Leave empty for the assistant's default model
AI_MODEL=
DESKTOP_NOTIFY=1
NTFY_URL=
# Remote desktop card (the installer sets these when you turn it on)
REMOTE_DESKTOP=0
# gnome (GNOME Remote Login), vnc (Raspberry Pi OS) or xrdp (other desktops). Not used on Windows.
RDP_KIND=gnome
RDP_USER=remote
# Your Tailscale name, e.g. mypc.tail1234.ts.net (the installer fills this in)
ALLOWED_HOSTS=

# Windows only: the pythonw.exe that runs the dashboard (the installer fills this in)
# PYTHONW=
